{
	"name": "pi-switchboard",
	"version": "0.14.2",
	"type": "module",
	"description": "Route the pi coding agent through Switchboard: one prepaid balance, spend controls, and a ledger for every model in the catalog",
	"keywords": [
		"pi-package"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Valni-Labs/pi-switchboard"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"test": "npm run typecheck && node --test \"extensions/switchboard/tests/*.test.ts\"",
		"typecheck": "tsc --noEmit"
	},
	"pi": {
		"extensions": [
			"./extensions"
		]
	},
	"devDependencies": {
		"@earendil-works/pi-ai": ">=1.0.0",
		"@earendil-works/pi-coding-agent": ">=1.0.0",
		"typescript": "5.9.3"
	}
}
